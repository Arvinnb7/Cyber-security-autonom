# Copy to .env and adjust. Most vars are prefixed with SENTINEL_.

# Data mode: "demo" (seeded mock data + simulators, the default) or "live"
# (no demo data, no simulators — the DB is fed only by real connectors).
DATA_MODE=demo

# Enable real Claude analysis/summary/chat (leave empty to use rule-based fallback).
SENTINEL_ANTHROPIC_API_KEY=

# Models (defaults are fine).
SENTINEL_AI_MODEL_DEEP=claude-opus-4-8
SENTINEL_AI_MODEL_FAST=claude-sonnet-4-6

# Database (SQLite by default; point at Postgres for production).
SENTINEL_DATABASE_URL=sqlite:///./sentinel.db

# Auth (CHANGE THESE).
SENTINEL_JWT_SECRET=change-me-in-production-please
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=admin

# Simulation.
SENTINEL_SIM_ENABLED=true
SENTINEL_INGEST_INTERVAL_SECONDS=20
SENTINEL_SEED_ON_STARTUP=true
