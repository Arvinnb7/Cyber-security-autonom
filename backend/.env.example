# Copy to .env and adjust. Most vars are prefixed with SENTINEL_.

# Data mode: "demo" (seeded mock data + simulators, the default) or "live"
# (no demo data, no simulators — the DB is fed only by real connectors).
DATA_MODE=demo

# Enable real Claude analysis/summary/chat (leave empty to use rule-based fallback).
SENTINEL_ANTHROPIC_API_KEY=

# Models (defaults are fine).
SENTINEL_AI_MODEL_DEEP=claude-opus-4-8
SENTINEL_AI_MODEL_FAST=claude-sonnet-4-6

# Database. SQLite for dev; PostgreSQL for production (schema managed by Alembic).
# Postgres example: postgresql+psycopg://user:pass@host:5432/sentinel
SENTINEL_DATABASE_URL=sqlite:///./sentinel.db

# Background scheduler. In production run it in ONE dedicated worker and set this
# to false on the API workers to avoid duplicate ingestion.
SENTINEL_RUN_SCHEDULER=true
# Purge raw events/signals older than N days (incidents are kept).
SENTINEL_RETENTION_DAYS=90

# Observability
SENTINEL_JSON_LOGS=false          # structured JSON logs (recommended in prod)
SENTINEL_METRICS_ENABLED=true     # expose Prometheus /metrics
SENTINEL_SENTRY_DSN=              # set to enable error tracking

# Environment: "dev" or "production". In production the app REFUSES to boot
# while any secret below is still at its insecure default.
SENTINEL_ENVIRONMENT=dev

# Auth (CHANGE THESE IN PRODUCTION). The bootstrap admin is seeded (hashed) into
# the account table on first boot only; manage users from the Team & Access page.
SENTINEL_JWT_SECRET=change-me-in-production-please
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=admin

# Dedicated key that encrypts connector credentials at rest (independent of the
# JWT secret). Generate a strong random value in production.
SENTINEL_ENCRYPTION_KEY=

# Comma-separated browser origins allowed by CORS (no wildcard in production).
SENTINEL_CORS_ORIGINS=http://localhost:3000

# Simulation.
SENTINEL_SIM_ENABLED=true
SENTINEL_INGEST_INTERVAL_SECONDS=20
SENTINEL_SEED_ON_STARTUP=true
